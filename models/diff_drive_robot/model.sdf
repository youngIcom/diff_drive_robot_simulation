<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="diff_drive_robot">
    <static>false</static>

    <!-- ========================================== -->
    <!-- BASE CHASSIS (SolidWorks CAD Design)       -->
    <!-- ========================================== -->
    <link name="base">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.0052 -0.00013 0.0624 0 0 0</pose>
        <mass>0.825</mass>
        <inertia>
          <ixx>0.000752</ixx>
          <ixy>-3.386e-07</ixy>
          <ixz>1.329e-07</ixz>
          <iyy>0.000721</iyy>
          <iyz>1.824e-07</iyz>
          <izz>0.001377</izz>
        </inertia>
      </inertial>

      <!-- Visual CAD Mesh -->
      <visual name="base_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://diff_drive_robot/meshes/base.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.79 0.82 0.93 1.0</ambient>
          <diffuse>0.79 0.82 0.93 1.0</diffuse>
          <specular>0.4 0.4 0.4 1.0</specular>
        </material>
      </visual>

      <!-- Collision Bounding Box (Chassis - Raised to avoid ground scraping) -->
      <collision name="base_chassis_collision">
        <pose>0.014 0 0.058 0 0 0</pose>
        <geometry>
          <box>
            <size>0.170 0.120 0.090</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.05</mu>
              <mu2>0.05</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Front Low-Friction Caster Contact (Level with wheels at z = -0.002) -->
      <collision name="front_caster_collision">
        <pose>0.080 0 0.002 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.004</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.001</mu>
              <mu2>0.001</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Rear Low-Friction Caster Contact (Prevents tail dragging and pitch friction) -->
      <collision name="rear_caster_collision">
        <pose>-0.075 0 0.002 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.004</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.001</mu>
              <mu2>0.001</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Visual Front Camera Lens -->
      <visual name="camera_lens_visual">
        <pose>0.102 0 0.065 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
        </material>
      </visual>

      <!-- SENSOR: Front Camera for Vision Node -->
      <sensor name="front_camera" type="camera">
        <pose>0.102 0 0.065 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/camera/image_raw</topic>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <!-- ========================================== -->
    <!-- RIGHT WHEEL                                -->
    <!-- ========================================== -->
    <link name="r_wheel">
      <pose>-0.051 -0.0856 0.032 0 0 0</pose>
      <inertial>
        <pose>0 0.00966 0 0 0 0</pose>
        <mass>0.0247</mass>
        <inertia>
          <ixx>1.014e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.697e-05</iyy>
          <iyz>0</iyz>
          <izz>1.014e-05</izz>
        </inertia>
      </inertial>
      <visual name="r_wheel_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://diff_drive_robot/meshes/r_wheel.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.25 1.0</ambient>
          <diffuse>0.3 0.3 0.3 1.0</diffuse>
        </material>
      </visual>
      <collision name="r_wheel_collision">
        <pose>0 0.010 0 -1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.034</radius>
            <length>0.028</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- ========================================== -->
    <!-- LEFT WHEEL                                 -->
    <!-- ========================================== -->
    <link name="l_wheel">
      <pose>-0.051 0.0856 0.032 0 0 0</pose>
      <inertial>
        <pose>0 -0.00966 0 0 0 0</pose>
        <mass>0.0247</mass>
        <inertia>
          <ixx>1.014e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.697e-05</iyy>
          <iyz>0</iyz>
          <izz>1.014e-05</izz>
        </inertia>
      </inertial>
      <visual name="l_wheel_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://diff_drive_robot/meshes/l_wheel.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.25 1.0</ambient>
          <diffuse>0.3 0.3 0.3 1.0</diffuse>
        </material>
      </visual>
      <collision name="l_wheel_collision">
        <pose>0 -0.010 0 -1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.034</radius>
            <length>0.028</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- ========================================== -->
    <!-- IMU SENSOR BOARD                           -->
    <!-- ========================================== -->
    <link name="imu">
      <pose>-0.00826 -0.00044 0.0391 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>4.66e-08</ixx>
          <iyy>3.74e-08</iyy>
          <izz>8.34e-08</izz>
        </inertia>
      </inertial>
      <visual name="imu_visual">
        <geometry>
          <mesh>
            <uri>model://diff_drive_robot/meshes/imu.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.3 0.8 1.0</ambient>
          <diffuse>0.1 0.4 0.9 1.0</diffuse>
        </material>
      </visual>
      <!-- SENSOR: IMU Sensor for EKF Fusion -->
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/imu/data</topic>
        <visualize>true</visualize>
        <gz:frame_id>diff_drive_robot/imu</gz:frame_id>
      </sensor>
    </link>

    <!-- ========================================== -->
    <!-- JOINTS                                     -->
    <!-- ========================================== -->
    <!-- Right Wheel Joint -->
    <joint name="right" type="revolute">
      <parent>base</parent>
      <child>r_wheel</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>

    <!-- Left Wheel Joint -->
    <joint name="left" type="revolute">
      <parent>base</parent>
      <child>l_wheel</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>

    <!-- IMU Fixed Joint -->
    <joint name="imu_joint" type="fixed">
      <parent>base</parent>
      <child>imu</child>
    </joint>

    <!-- ========================================== -->
    <!-- PLUGINS                                    -->
    <!-- ========================================== -->
    <!-- Differential Drive Plugin -->
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>left</left_joint>
      <right_joint>right</right_joint>
      <wheel_separation>0.1712</wheel_separation>
      <wheel_radius>0.034</wheel_radius>
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <min_linear_acceleration>-1.5</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
      <max_linear_velocity>0.8</max_linear_velocity>
      <min_linear_velocity>-0.8</min_linear_velocity>
      <max_angular_velocity>2.5</max_angular_velocity>
      <min_angular_velocity>-2.5</min_angular_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/wheel/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>diff_drive_robot/base</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- IMU Sensor System Plugin -->
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <!-- Joint State Publisher Plugin (Encoder Feedback) -->
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <joint_name>left</joint_name>
      <joint_name>right</joint_name>
      <topic>/joint_states</topic>
      <update_rate>30</update_rate>
    </plugin>

    <!-- Ground Truth Odometry Plugin (Absolute World Pose, Zero Slip Drift) -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>diff_drive_robot/base</robot_base_frame>
      <odom_topic>/ground_truth/odom</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

  </model>
</sdf>
